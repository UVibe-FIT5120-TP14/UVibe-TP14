# Required
SECRET_KEY=your-secret-key-here
DATABASE_URL=sqlite:///./app.db

# Optional (defaults shown)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24
ALLOWED_ORIGINS=http://localhost:3000
OPENWEATHER_API_KEY=your-openweather-api-key

# Set to "true" only in local dev to seed a test user
SEED_DB=false

# Data
UV_DATA_URL=https://www.dropbox.com/scl/fi/2nur1f2dohi69e084awii/data.zip?rlkey=k9vuitrsmiupx2sfsb4qspilm&st=vmja7w3y&dl=1
